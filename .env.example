# PortalClient Environment Configuration Example
# Copy this file to .env and configure your desired settings

# --- AI Provider API Keys ---
# Provide at least one API key if you plan to use AI analysis features.
# Keys can also be configured securely in the Desktop Preferences UI (stored via Windows DPAPI).
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# --- Timing & Behavioral Settings ---
# Window in seconds for detecting multi-tap activation
TRIPLE_TAP_WINDOW=0.5
# Duration in seconds to display visual response overlay
RESPONSE_DURATION=2.0

# --- Process & Console Stealth Settings ---
HIDE_PROCESS=true
HIDE_CONSOLE=true

# --- Backend Authentication Server URL ---
# The local Flask server defaults to port 5000:
AUTH_SERVER_URL=http://127.0.0.1:5000

# --- Optional Server Admin Password (used during initial admin seeding) ---
# ADMIN_PASSWORD=admin123
